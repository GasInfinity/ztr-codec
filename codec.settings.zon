.{
    // I'd like to call it ztr-codec but it's too long :(
    .title = "ztr-cdc",
    .product_code = "ztr-cxi-make",
    .remaster_version = 7,
    .title_id = .{
        .variation = 0x02,
        .unique = 0x18,
        .category = 0x0130,
    },
    .flags = .{ .compress = true, .allow_sd_usage = false },
    .stack_size = 4096,
    .access_control = .{
        .kernel = .{
            .flags = .{
                .allow_debug = false,
                .force_debug = false,
                .allow_non_alphanumeric = false,
                .shared_page_writing = true,
                .allow_privileged_priorities = false,
                .allow_main_args = false,
                .shared_device_memory = false,
                .runnable_on_sleep = true,
                .memory_type = .base,
                .special_memory = false,
                .allow_cpu2 = false,
            },
            .handle_table_size = 0,
            .mapped_io_pages = .{
                // Blud, why tf you depending on pdn if literally you can write there
                .{ .address = 0x1EC41000, .read_only = false },
                .{ .address = 0x1EC45000, .read_only = false },
                .{ .address = 0x1EC03000, .read_only = false },
            },
            .system_call_access = .{
                .control_memory,
                .query_memory,
                .exit,
                .get_process_ideal_processor,
                .create_thread,
                .exit_thread,
                .sleep_thread,
                .get_thread_priority,
                .set_thread_priority,
                .get_thread_ideal_processor,
                .get_cpu_count,
                .create_mutex,
                .release_mutex,
                .create_semaphore,
                .release_semaphore,
                .create_event,
                .signal_event,
                .clear_event,
                .create_timer,
                .set_timer,
                .cancel_timer,
                .clear_timer,
                .create_memory_block,
                .map_memory_block,
                .unmap_memory_block,
                .create_address_arbiter,
                .arbitrate_address,
                .close_handle,
                .wait_synchronization,
                .wait_synchronization_multiple,
                .duplicate_handle,
                .get_system_tick,
                .get_handle_info,
                .get_system_info,
                .get_process_info,
                .get_thread_info,
                .connect_to_port,
                .send_sync_request1,
                .send_sync_request2,
                .send_sync_request3,
                .send_sync_request4,
                .send_sync_request,
                .get_process_id,
                .get_process_id_of_thread,
                .get_thread_id,
                .get_resource_limit,
                .get_resource_limit_limit_values,
                .get_resource_limit_current_values,
                .get_thread_context,
                .break_execution,
                .output_debug_string,
                .create_port,
                .create_session_to_port,
                .accept_session,
                .reply_and_receive1,
                .reply_and_receive2,
                .reply_and_receive3,
                .reply_and_receive4,
                .reply_and_receive,
                .bind_interrupt,
                .unbind_interrupt,
                .invalidate_process_data_cache,
                .store_process_data_cache,
                .flush_process_data_cache,
                .start_inter_process_dma,
                .stop_dma,
                .get_dma_state,
            },
        },
        .new_speedup = .{ .enable_l2_cache = false, .cpu_speed = .@"268Mhz" },
        .new_execution = .{ .mode = .legacy },
        .execution = .{
            .ideal_processor = 1,
            .affinity_mask = 2,
            .mode = .prod,
            .priority = 20,
        },
        .storage = .{
            .extended_save_data_id = 0,
            .save_data_id = 0,
            .storage_uuid = 0,
            .access = .{
                .system_application = false,
                .hardware_check = false,
                .filesystem_tool = false,
                .debug = false,
                .twl_card_backup = false,
                .twl_nand_data = false,
                .boss = false,
                .sdmc = false,
                .core = false,
                .nand_ro = false,
                .nand_rw = false,
                .nand_ro_rw = false,
                .system_settings = false,
                .cardboard = false,
                .export_import_ivs = false,
                .sdmc_wo = false,
                .switch_cleanup = false,
                .save_data_move = false,
                .shop = false,
                .shell = false,
                .home_menu = false,
                .seed_db = false,
            },
        },
        .service_access = .{
            "pdn:i",
            "SPI::CD2",
            "gpio:CDC",
            "mcu::CDC",
            "cfg:s",
            "ptm:s",
        },
        .category = .other,
    },
    .dependencies = .{
        0x4013000001702, // cfg
        0x4013000001B02, // gpio
        0x4013000001F02, // mcu
        0x4013000002102, // pdn
        0x4013000002302, // spi
    },
}
